/**
 * Epic Games 免费游戏 API 服务
 * 数据来源: https://60s.viki.moe/v2/epic
 */

/* ========== 类型定义 ========== */

export interface EpicGame {
	id: string
	title: string
	cover: string
	original_price: number
	original_price_desc: string
	description: string
	seller: string
	is_free_now: boolean
	free_start: string
	free_start_at: number
	free_end: string
	free_end_at: number
	link: string
}

export interface EpicResponse {
	code: number
	message: string
	data: EpicGame[]
}

export interface ApiResult<T> {
	success: boolean
	data: T | null
	error: string | null
	message: string
}

/* ========== 常量 ========== */

const API_BASE = 'https://60s.viki.moe/v2'
const EPIC_ENDPOINT = `${API_BASE}/epic`
const REQUEST_TIMEOUT = 15000

/* ========== 核心请求函数 ========== */

function request<T>(url: string, options: RequestOptions = {}): Promise<ApiResult<T>> {
	return new Promise((resolve) => {
		uni.request({
			url,
			method: options.method ?? 'GET',
			timeout: options.timeout ?? REQUEST_TIMEOUT,
			success: (res) => {
				const statusCode = res.statusCode
				if (statusCode === 200) {
					resolve({
						success: true,
						data: res.data as T,
						error: null,
						message: 'ok',
					})
				} else {
					resolve({
						success: false,
						data: null,
						error: `HTTP ${statusCode}`,
						message: `请求失败，状态码: ${statusCode}`,
					})
				}
			},
			fail: (err) => {
				resolve({
					success: false,
					data: null,
					error: err.errMsg ?? '网络请求失败',
					message: '网络连接异常，请检查网络后重试',
				})
			},
		})
	})
}

/* ========== Epic Games API ========== */

/**
 * 获取 Epic Games 免费游戏列表
 */
export function fetchEpicGames(): Promise<ApiResult<EpicResponse>> {
	return request<EpicResponse>(EPIC_ENDPOINT)
}

/**
 * 获取当前可免费领取的游戏
 */
export function getFreeNowGames(games: EpicGame[]): EpicGame[] {
	return games.filter((g) => g.is_free_now)
}

/**
 * 获取即将免费的游戏
 */
export function getUpcomingGames(games: EpicGame[]): EpicGame[] {
	return games.filter((g) => !g.is_free_now)
}

/**
 * 格式化时间戳为可读日期
 */
export function formatFreeTime(dateStr: string): string {
	if (!dateStr) return ''
	const parts = dateStr.split(' ')
	if (parts.length >= 2) {
		return parts[0].replace(/\//g, '-')
	}
	return dateStr
}

/**
 * 计算剩余可领取时间（小时）
 */
export function getRemainingHours(freeEndAt: number): number {
	const now = Date.now()
	const remaining = freeEndAt - now
	if (remaining <= 0) return 0
	return Math.ceil(remaining / (1000 * 60 * 60))
}

/**
 * 格式化剩余时间文本
 */
export function formatRemainingTime(freeEndAt: number): string {
	const hours = getRemainingHours(freeEndAt)
	if (hours <= 0) return '已结束'
	if (hours < 24) return `剩余 ${hours} 小时`
	const days = Math.floor(hours / 24)
	return `剩余 ${days} 天`
}