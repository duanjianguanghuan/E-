/**
 * Epic Games 免费游戏 API 服务
 * 数据来源: https://60s.viki.moe/v2/epic
 *
 * 功能: 类型定义 | 请求封装 | 缓存机制 | 时间工具
 */

/* ========== 类型定义 ========== */

export interface EpicGame {
	id: string
	title: string
	cover: string
	original_price: number
	original_price_desc: string
	description: string
	seller: string
	is_free_now: boolean
	free_start: string
	free_start_at: number
	free_end: string
	free_end_at: number
	link: string
}

export interface EpicResponse {
	code: number
	message: string
	data: EpicGame[]
}

export interface ApiResult<T> {
	success: boolean
	data: T | null
	error: string | null
	message: string
}

export interface TimeDisplay {
	text: string          // 显示文本
	type: 'countdown' | 'expired' | 'upcoming' | 'normal'
	remaining: number     // 剩余时间（毫秒）
	isUrgent: boolean     // 是否紧急（<24小时）
}

/* ========== 常量 ========== */

const API_BASE = 'https://60s.viki.moe/v2'
const EPIC_ENDPOINT = `${API_BASE}/epic`
const REQUEST_TIMEOUT = 15000
const CACHE_DURATION = 5 * 60 * 1000 // 5 分钟缓存

/* ========== 缓存管理 ========== */

const cache: Record<string, CacheEntry<any>> = {}

interface CacheEntry<T> {
	data: T
	timestamp: number
}

function getCache<T>(key: string): T | null {
	const entry = cache[key]
	if (!entry) return null
	const now = Date.now()
	if (now - entry.timestamp > CACHE_DURATION) {
		delete cache[key]
		return null
	}
	return entry.data as T
}

function setCache<T>(key: string, data: T): void {
	cache[key] = {
		data,
		timestamp: Date.now(),
	}
}

export function clearCache(): void {
	Object.keys(cache).forEach((k) => delete cache[k])
}

export function getCacheTimestamp(key: string): number | null {
	const entry = cache[key]
	return entry ? entry.timestamp : null
}

/* ========== 请求封装 ========== */

interface RequestOptions {
	method?: 'GET' | 'POST'
	timeout?: number
}

function request<T>(url: string, options: RequestOptions = {}): Promise<ApiResult<T>> {
	return new Promise((resolve) => {
		uni.request({
			url: url,
			method: options.method ?? 'GET',
			timeout: options.timeout ?? REQUEST_TIMEOUT,
			success: (res) => {
				const statusCode = res.statusCode
				if (statusCode === 200 && res.data != null) {
					resolve({
						success: true,
						data: res.data as T,
						error: null,
						message: 'ok',
					})
				} else {
					resolve({
						success: false,
						data: null,
						error: `HTTP ${statusCode}`,
						message: `请求失败，状态码: ${statusCode}`,
					})
				}
			},
			fail: (err) => {
				const msg = err.errMsg ?? ''
				if (msg.includes('abort')) {
					resolve({
						success: false,
						data: null,
						error: 'REQUEST_ABORT',
						message: '请求已取消',
					})
				} else {
					resolve({
						success: false,
						data: null,
						error: msg || '网络请求失败',
						message: '网络连接异常，请检查网络后重试',
					})
				}
			},
		})
	})
}

/* ========== 唯一请求标识 ========== */

let currentRequestId = 0
function nextRequestId(): number {
	return ++currentRequestId
}

/* ========== Epic Games API ========== */

/**
 * 获取 Epic Games 免费游戏列表（带缓存）
 */
export function fetchEpicGames(forceRefresh: boolean = false): Promise<ApiResult<EpicResponse>> {
	return new Promise((resolve) => {
		const requestId = nextRequestId()

		// 检查缓存
		if (!forceRefresh) {
			const cached = getCache<EpicResponse>(EPIC_ENDPOINT)
			if (cached && cached.data) {
				resolve({
					success: true,
					data: cached,
					error: null,
					message: 'ok (cached)',
				})
				return
			}
		}

		// 发送请求
		request<EpicResponse>(EPIC_ENDPOINT).then((result) => {
			// 只有最新请求的结果才更新缓存
			if (requestId === currentRequestId && result.success && result.data) {
				setCache(EPIC_ENDPOINT, result.data)
			}
			resolve(result)
		})
	})
}

/**
 * 取消当前请求
 */
export function cancelCurrentRequest(): void {
	currentRequestId++
}

/* ========== 数据筛选工具 ========== */

/**
 * 筛选当前可免费领取的游戏
 */
export function getFreeNowGames(games: EpicGame[]): EpicGame[] {
	return games.filter((g) => g.is_free_now)
}

/**
 * 筛选即将免费的游戏
 */
export function getUpcomingGames(games: EpicGame[]): EpicGame[] {
	return games.filter((g) => !g.is_free_now)
}

/* ========== 时间工具 ========== */

/**
 * 解析日期字符串为 Date 对象
 * 支持格式: "YYYY/MM/DD HH:mm:ss" 或 "YYYY-MM-DD HH:mm:ss"
 */
export function parseDate(dateStr: string): Date | null {
	if (!dateStr) return null

	// 尝试多种格式
	let parts: string[]
	if (dateStr.includes('/')) {
		parts = dateStr.split(' ')
		const dateParts = parts[0].split('/')
		if (dateParts.length === 3) {
			const year = parseInt(dateParts[0], 10)
			const month = parseInt(dateParts[1], 10) - 1
			const day = parseInt(dateParts[2], 10)
			if (!isNaN(year) && !isNaN(month) && !isNaN(day)) {
				if (parts.length > 1 && parts[1]) {
					const timeParts = parts[1].split(':')
					const hour = parseInt(timeParts[0] ?? '0', 10)
					const minute = parseInt(timeParts[1] ?? '0', 10)
					const second = parseInt(timeParts[2] ?? '0', 10)
					return new Date(year, month, day, hour, minute, second)
				}
				return new Date(year, month, day)
			}
		}
	} else if (dateStr.includes('-')) {
		parts = dateStr.split(' ')
		const dateParts = parts[0].split('-')
		if (dateParts.length === 3) {
			const year = parseInt(dateParts[0], 10)
			const month = parseInt(dateParts[1], 10) - 1
			const day = parseInt(dateParts[2], 10)
			if (!isNaN(year) && !isNaN(month) && !isNaN(day)) {
				if (parts.length > 1 && parts[1]) {
					const timeParts = parts[1].split(':')
					const hour = parseInt(timeParts[0] ?? '0', 10)
					const minute = parseInt(timeParts[1] ?? '0', 10)
					const second = parseInt(timeParts[2] ?? '0', 10)
					return new Date(year, month, day, hour, minute, second)
				}
				return new Date(year, month, day)
			}
		}
	}

	return null
}

/**
 * 计算剩余时间（毫秒）
 */
export function getRemainingMs(endTime: number | string | Date): number {
	const now = Date.now()
	let endMs: number

	if (typeof endTime === 'number') {
		// 如果是时间戳
		endMs = endTime > 9999999999 ? endTime : endTime * 1000
	} else if (endTime instanceof Date) {
		endMs = endTime.getTime()
	} else {
		const parsed = parseDate(endTime)
		endMs = parsed ? parsed.getTime() : 0
	}

	return Math.max(0, endMs - now)
}

/**
 * 获取时间显示信息
 */
export function getTimeDisplay(freeEndStr: string, freeEndAt: number, isFreeNow: boolean): TimeDisplay {
	if (!isFreeNow) {
		// 即将推出的游戏
		const remaining = getRemainingMs(freeEndAt)
		const days = Math.floor(remaining / (1000 * 60 * 60 * 24))
		const hours = Math.floor((remaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))

		if (days > 0) {
			return {
				text: `${days} 天后开始`,
				type: 'upcoming',
				remaining,
				isUrgent: false,
			}
		} else if (hours > 0) {
			return {
				text: `${hours} 小时后开始`,
				type: 'upcoming',
				remaining,
				isUrgent: hours < 24,
			}
		} else {
			return {
				text: '即将开始',
				type: 'upcoming',
				remaining,
				isUrgent: true,
			}
		}
	}

	// 当前免费的游戏
	const remaining = getRemainingMs(freeEndAt)

	if (remaining <= 0) {
		return {
			text: '已结束',
			type: 'expired',
			remaining: 0,
			isUrgent: false,
		}
	}

	const totalHours = Math.floor(remaining / (1000 * 60 * 60))
	const days = Math.floor(totalHours / 24)
	const hours = totalHours % 24
	const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60))

	if (days > 0) {
		return {
			text: `还剩 ${days} 天 ${hours} 小时`,
			type: 'countdown',
			remaining,
			isUrgent: days < 1,
		}
	} else if (hours > 0) {
		return {
			text: `还剩 ${hours} 小时 ${minutes} 分钟`,
			type: 'countdown',
			remaining,
			isUrgent: true,
		}
	} else {
		const secs = Math.floor((remaining % (1000 * 60)) / 1000)
		return {
			text: `还剩 ${minutes} 分钟 ${secs} 秒`,
			type: 'countdown',
			remaining,
			isUrgent: true,
		}
	}
}

/**
 * 格式化日期为友好显示 (YYYY/MM/DD HH:mm → YYYY-MM-DD HH:mm)
 */
export function formatDateTime(dateStr: string): string {
	if (!dateStr) return ''
	const parts = dateStr.split(' ')
	if (parts.length >= 2) {
		return `${parts[0].replace(/\//g, '-')} ${parts[1]}`
	}
	return dateStr.replace(/\//g, '-')
}

/**
 * 格式化日期为简短显示 (YYYY/MM/DD → MM-DD)
 */
export function formatShortDate(dateStr: string): string {
	if (!dateStr) return ''
	const parts = dateStr.split(' ')[0]
	if (parts.includes('/')) {
		const p = parts.split('/')
		if (p.length === 3) {
			return `${p[1]}-${p[2]}`
		}
	}
	if (parts.includes('-')) {
		const p = parts.split('-')
		if (p.length === 3) {
			return `${p[1]}-${p[2]}`
		}
	}
	return parts
}

/**
 * 获取当前时间的友好描述
 */
export function getFriendlyTime(): string {
	const now = new Date()
	const hour = now.getHours()

	if (hour >= 5 && hour < 11) return '早上好'
	if (hour >= 11 && hour < 14) return '中午好'
	if (hour >= 14 && hour < 18) return '下午好'
	if (hour >= 18 && hour < 22) return '晚上好'
	return '夜深了'
}

/**
 * 判断是否即将结束（<6小时）
 */
export function isExpiringSoon(freeEndAt: number): boolean {
	const remaining = getRemainingMs(freeEndAt)
	return remaining > 0 && remaining < 6 * 60 * 60 * 1000
}
