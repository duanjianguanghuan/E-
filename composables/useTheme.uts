import { ref, computed } from 'vue'

/* ========== 类型定义 ========== */
// 主题风格
export type ThemeStyle = 'normal' | 'liquid-glass'
// 颜色模式
export type ColorMode = 'light' | 'dark' | 'auto'

let initialized = false

/* ========== 状态 ========== */
const currentStyle = ref<ThemeStyle>('normal')
const currentMode = ref<ColorMode>('auto')

// 检测系统深色模式
function getSystemDarkMode(): boolean {
	try {
		const info = uni.getSystemInfoSync()
		return info.theme === 'dark'
	} catch {
		return false
	}
}

// 当前实际生效的颜色模式（考虑auto模式）
const effectiveMode = computed(() => {
	if (currentMode.value === 'auto') {
		return getSystemDarkMode() ? 'dark' : 'light'
	}
	return currentMode.value
})

/* ========== 核心函数 ========== */
export function useTheme() {
	if (!initialized) {
		// 读取风格
		const savedStyle = uni.getStorageSync('app_theme_style')
		if (savedStyle === 'liquid-glass' || savedStyle === 'normal') {
			currentStyle.value = savedStyle as ThemeStyle
		}
		// 读取模式
		const savedMode = uni.getStorageSync('app_color_mode')
		if (savedMode === 'light' || savedMode === 'dark' || savedMode === 'auto') {
			currentMode.value = savedMode as ColorMode
		}
		initialized = true
	}

	/* ========== 计算属性 ========== */
	const isNormal = computed(() => currentStyle.value === 'normal')
	const isLiquidGlass = computed(() => currentStyle.value === 'liquid-glass')

	const isLight = computed(() => effectiveMode.value === 'light')
	const isDark = computed(() => effectiveMode.value === 'dark')
	const isAuto = computed(() => currentMode.value === 'auto')

	// 综合主题类名（用于 CSS）
	const themeClass = computed(() => {
		const baseClass = currentStyle.value === 'liquid-glass' ? 'theme-glass' : 'theme-normal'
		const modeClass = effectiveMode.value === 'dark' ? 'mode-dark' : 'mode-light'
		return `${baseClass} ${modeClass}`
	})

	/* ========== 风格切换 ========== */
	function setStyle(style: ThemeStyle) {
		if (currentStyle.value === style) return
		currentStyle.value = style
		uni.setStorageSync('app_theme_style', style)
	}

	function toggleStyle() {
		const next: ThemeStyle = currentStyle.value === 'normal' ? 'liquid-glass' : 'normal'
		setStyle(next)
	}

	/* ========== 模式切换 ========== */
	function setMode(mode: ColorMode) {
		if (currentMode.value === mode) return
		currentMode.value = mode
		uni.setStorageSync('app_color_mode', mode)
	}

	/* ========== 导出 ========== */
	return {
		currentStyle,
		currentMode,
		isNormal,
		isLiquidGlass,
		isLight,
		isDark,
		isAuto,
		themeClass,
		setStyle,
		setMode,
		toggleStyle,
	}
}
