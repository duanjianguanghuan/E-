	.settings-page.theme-glass {
		background: linear-gradient(135deg, #0a0a1a 0%, #1a1030 30%, #0d1b2a 60%, #0a0a1a 100%);
	}

	.header.theme-glass {
		background: rgba(255, 255, 255, 0.04);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.back-icon.theme-glass {
		color: rgba(160, 200, 255, 0.9);
	}

	.header-title.theme-glass {
		color: rgba(255, 255, 255, 0.92);
