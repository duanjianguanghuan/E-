				<!-- 跟随系统 -->
				<view
					:class="['mode-card', themeClass, { active: isAuto }]"
					@tap="onSelectMode('auto')"
				>
					<view :class="['mode-visual', 'visual-auto', themeClass]">
						<view class="visual-half-half"></view>
					</view>
					<view class="mode-body">
						<view class="mode-title-row">
							<text :class="['mode-name', themeClass]">跟随系统</text>
							<view v-if="isAuto" :class="['check-icon', themeClass]">
								<text class="check-text">✓</text>
							</view>
						</view>
						<text :class="['mode-desc', themeClass]">自动切换</text>
					</view>
				</view>
			</view>

			<!-- 界面风格 -->
			<view :class="['section', themeClass]">
				<view class="section-header">
					<text :class="['section-title', themeClass]">界面风格</text>
					<text :class="['section-desc', themeClass]">选择你的专属风格</text>
				</view>

				<!-- 经典简约 -->
				<view
					:class="['theme-card', themeClass, { active: isNormal }]"
					@tap="onSelectStyle('normal')"
				>
					<view :class="['card-visual', themeClass]">
						<view class="visual-bar"></view>
						<view class="visual-body">
							<view class="visual-block w80"></view>
							<view class="visual-block w50"></view>
						</view>
					</view>
					<view class="card-body">
						<view class="card-title-row">
							<text :class="['card-name', themeClass]">经典简约</text>
							<view v-if="isNormal" :class="['check-icon', themeClass]">
