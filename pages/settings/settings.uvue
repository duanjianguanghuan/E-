						</view>
						<text :class="['mode-desc', themeClass]">明亮清爽</text>
					</view>
				</view>

				<!-- 深色模式 -->
				<view
					:class="['mode-card', themeClass, { active: isDark }]"
					@tap="onSelectMode('dark')"
				>
