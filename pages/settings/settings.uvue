		flex: 1;
	}

	/* ---------- 分区 ---------- */
	.section {
		margin: 16px;
		padding: 20px 18px;
		border-radius: 16px;
		background-color: #ffffff;
	}

	.section-header {
		margin-bottom: 16px;
	}

	.section-title {
		font-size: 16px;
		font-weight: 700;
		color: #1c1c1e;
		display: block;
	}

	.section-desc {
		font-size: 12px;
		color: #8e8e93;
		margin-top: 4px;
		display: block;
	}

	/* ---------- 主题卡片 ---------- */
	.theme-card {
		flex-direction: row;
		align-items: center;
		padding: 12px;
		border-radius: 14px;
		background-color: #f8f8fa;
		margin-bottom: 10px;
		border: 2px solid transparent;
	}

	.theme-card:last-child {
		margin-bottom: 0;
	}

	.theme-card.active {
		border-color: #007aff;
		background-color: #f0f7ff;
	}

	/* 卡片视觉预览 */
	.card-visual {
		width: 52px;
		height: 52px;
		border-radius: 10px;
		overflow: hidden;
		margin-right: 12px;
		flex-shrink: 0;
		background-color: #e8e8ed;
	}

	.visual-glass {
		background: linear-gradient(135deg, rgba(120, 140, 255, 0.2), rgba(160, 120, 255, 0.15));
