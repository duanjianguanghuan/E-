<template>
	<view :class="['settings-page', themeClass]">
		<!-- 头部 -->
		<view :class="['header', themeClass]">
			<view class="header-content">
				<view class="back-btn" @tap="goBack">
					<text :class="['back-icon', themeClass]">←</text>
				</view>
				<text :class="['header-title', themeClass]">设置</text>
				<view class="header-spacer"></view>
			</view>
		</view>

		<!-- 页面内容 -->
		<scroll-view scroll-y="true" class="content-scroll">
			<!-- 主题切换 -->
			<view :class="['section', themeClass]">
				<view class="section-header">
					<text :class="['section-title', themeClass]">界面主题</text>
					<text :class="['section-desc', themeClass]">选择你的专属风格</text>
				</view>

				<!-- 经典简约 -->
				<view
					:class="['theme-card', themeClass, { active: isNormal }]"
					@tap="onSelectTheme('normal')"
				>
					<view :class="['card-visual', themeClass]">
						<view class="visual-bar"></view>
						<view class="visual-body">
							<view class="visual-block w80"></view>
							<view class="visual-block w50"></view>
						</view>
					</view>
					<view class="card-body">
						<view class="card-title-row">
							<text :class="['card-name', themeClass]">经典简约</text>
							<view v-if="isNormal" :class="['check-icon', themeClass]">
								<text class="check-text">✓</text>
							</view>
						</view>
						<text :class="['card-desc', themeClass]">简洁明亮，专注内容</text>
					</view>
				</view>

				<!-- 液体玻璃 -->
				<view
					:class="['theme-card', themeClass, { active: isLiquidGlass }]"
					@tap="onSelectTheme('liquid-glass')"
				>
					<view :class="['card-visual', 'visual-glass', themeClass]">
						<view class="visual-bar glass-bar"></view>
						<view class="visual-body">
							<view class="visual-block glass-block w80"></view>
							<view class="visual-block glass-block w50"></view>
						</view>
					</view>
					<view class="card-body">
						<view class="card-title-row">
							<text :class="['card-name', themeClass]">液体玻璃</text>
							<view v-if="isLiquidGlass" :class="['check-icon', themeClass]">
								<text class="check-text">✓</text>
							</view>
						</view>
						<text :class="['card-desc', themeClass]">深邃通透，质感优雅</text>
					</view>
				</view>
			</view>

			<!-- 关于 -->
			<view :class="['section', themeClass]">
				<view class="section-header">
					<text :class="['section-title', themeClass]">关于应用</text>
				</view>

				<view :class="['info-item', themeClass]">
					<text :class="['info-label', themeClass]">应用名称</text>
					<text :class="['info-value', themeClass]">E游周享</text>
				</view>

				<view :class="['info-item', themeClass]">
					<text :class="['info-label', themeClass]">版本号</text>
					<text :class="['info-value', themeClass]">1.0.0</text>
				</view>

				<view :class="['info-item', themeClass]">
					<text :class="['info-label', themeClass]">数据来源</text>
					<text :class="['info-value', themeClass]">60s.viki.moe</text>
				</view>

				<view :class="['info-item', themeClass, 'info-item-last']">
					<text :class="['info-label', themeClass]">功能</text>
					<text :class="['info-value', themeClass]">Epic 免费游戏资讯</text>
				</view>
			</view>

			<!-- 底部安全区 -->
			<view class="bottom-safe"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useTheme } from '@/composables/useTheme'
	import type { ThemeType } from '@/composables/useTheme'
	import { computed } from 'vue'

	const { currentTheme, isLiquidGlass, isNormal, setTheme } = useTheme()

	const themeClass = computed(() => {
		return currentTheme.value === 'liquid-glass' ? 'theme-glass' : 'theme-normal'
	})

	/* ========== 主题切换 ========== */
	function onSelectTheme(theme: ThemeType) {
		if (currentTheme.value === theme) return
		setTheme(theme)
		uni.showToast({
			title: theme === 'normal' ? '已切换为经典简约' : '已切换为液体玻璃',
			icon: 'none',
			duration: 1500,
		})
	}

	/* ========== 返回 ========== */
	function goBack() {
		uni.navigateBack({})
	}
</script>

<style>
	/* ===================================== */
