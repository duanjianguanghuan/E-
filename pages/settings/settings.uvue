</template>

<script setup lang="uts">
	import { useTheme } from '@/composables/useTheme'
	import type { ThemeStyle, ColorMode } from '@/composables/useTheme'
	import { computed } from 'vue'

	const {
		currentStyle,
		currentMode,
		isNormal,
		isLiquidGlass,
		isLight,
		isDark,
		isAuto,
		themeClass,
		setStyle,
		setMode,
	} = useTheme()

	/* ========== 主题风格切换 ========== */
	function onSelectStyle(style: ThemeStyle) {
		if (currentStyle.value === style) return
		setStyle(style)
		uni.showToast({
			title: style === 'normal' ? '已切换为经典简约' : '已切换为液体玻璃',
			icon: 'none',
			duration: 1500,
		})
	}

	/* ========== 颜色模式切换 ========== */
	function onSelectMode(mode: ColorMode) {
		if (currentMode.value === mode) return
		setMode(mode)
		let title = ''
		if (mode === 'light') title = '已切换为浅色模式'
		else if (mode === 'dark') title = '已切换为深色模式'
		else title = '已切换为跟随系统'
		uni.showToast({
			title,
			icon: 'none',
			duration: 1500,
		})
	}

	/* ========== 返回 ========== */
	function goBack() {
		uni.navigateBack({})
	}
</script>

