		flex: 1;
		padding: 6px;
		flex-direction: column;
		justify-content: space-around;
	}

	.visual-block {
		height: 7px;
		border-radius: 3px;
		background-color: #c7c7cc;
	}

	.visual-block.w80 {
		width: 80%;
	}

	.visual-block.w50 {
		width: 50%;
	}

	.glass-block {
		background: linear-gradient(90deg, rgba(140, 170, 255, 0.6), rgba(180, 140, 255, 0.4));
	}

	/* 卡片内容 */
	.card-body {
		flex: 1;
		flex-direction: column;
