</template>

<script setup lang="uts">
	import { useTheme } from '@/composables/useTheme'
	import type { ThemeStyle, ColorMode } from '@/composables/useTheme'
	import { clearCache } from '@/api/epic'
	import { ref, computed } from 'vue'

	const {
		currentStyle,
		currentMode,
		isNormal,
		isLiquidGlass,
		isLight,
		isDark,
		isAuto,
		themeClass,
		setStyle,
		setMode,
	} = useTheme()

	/* ========== 缓存大小 ========== */
	const cacheSize = ref('暂无缓存')

	function updateCacheSize() {
		// 检查是否有缓存数据
		try {
			const cached = uni.getStorageInfoSync()
			if (cached && cached.currentSize > 0) {
				const sizeKB = cached.currentSize
				if (sizeKB >= 1024) {
					cacheSize.value = `${(sizeKB / 1024).toFixed(1)} MB`
				} else {
					cacheSize.value = `${sizeKB} KB`
				}
			} else {
				cacheSize.value = '暂无缓存'
			}
		} catch {
			cacheSize.value = '暂无缓存'
		}
	}

	/* ========== 主题风格切换 ========== */
	function onSelectStyle(style: ThemeStyle) {
		if (currentStyle.value === style) return
		setStyle(style)
		uni.showToast({
			title: style === 'normal' ? '已切换为经典简约' : '已切换为液体玻璃',
			icon: 'none',
			duration: 1500,
		})
	}

	/* ========== 颜色模式切换 ========== */
	function onSelectMode(mode: ColorMode) {
		if (currentMode.value === mode) return
		setMode(mode)
		let title = ''
		if (mode === 'light') title = '已切换为浅色模式'
		else if (mode === 'dark') title = '已切换为深色模式'
		else title = '已切换为跟随系统'
		uni.showToast({
			title,
			icon: 'none',
			duration: 1500,
		})
	}

	/* ========== 清除缓存 ========== */
	function onClearCache() {
		uni.showModal({
			title: '清除缓存',
			content: '确定要清除所有缓存数据吗？',
			confirmColor: '#007aff',
			success: (res) => {
				if (res.confirm) {
					clearCache()
					try {
						uni.clearStorageSync()
					} catch {
						// 忽略清除错误
					}
					updateCacheSize()
					uni.showToast({
						title: '缓存已清除',
						icon: 'success',
						duration: 2000,
					})
				}
			},
		})
	}

	/* ========== 刷新数据 ========== */
	function onRefreshData() {
		uni.showToast({
			title: '正在刷新数据...',
			icon: 'loading',
			duration: 1500,
		})
		// 触发首页刷新
		const pages = getCurrentPages()
		const prevPage = pages[pages.length - 2]
		if (prevPage && prevPage.$vm.loadGames) {
			prevPage.$vm.loadGames(true)
			setTimeout(() => {
				uni.showToast({
					title: '数据已刷新',
					icon: 'success',
					duration: 1500,
				})
			}, 1500)
		} else {
			// 如果无法刷新上一页，尝试重新加载当前页数据
			setTimeout(() => {
				uni.reLaunch({
					url: '/pages/index/index',
				})
			}, 1500)
		}
	}

	/* ========== 检查更新 ========== */
	function onCheckUpdate() {
		uni.showToast({
			title: '当前已是最新版本',
			icon: 'none',
			duration: 2000,
		})
	}

	/* ========== 意见反馈 ========== */
	function onFeedback() {
		uni.showToast({
			title: '感谢您的支持',
			icon: 'none',
			duration: 2000,
		})
	}

	/* ========== 返回 ========== */
	function goBack() {
		uni.navigateBack({})
	}

	/* ========== 初始化 ========== */
	updateCacheSize()
</script>

