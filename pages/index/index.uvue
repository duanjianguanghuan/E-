<template>
	<view :class="['home-page', themeClass]">
		<!-- 状态栏占位 -->
		<view :class="['status-bar', themeClass]"></view>

		<!-- 顶部导航 -->
		<view :class="['navbar', themeClass]">
			<view class="navbar-left">
				<text :class="['greeting', themeClass]">{{ greetingText }}</text>
				<text :class="['subtitle', themeClass]">发现精彩旅程</text>
			</view>
			<view :class="['nav-actions', themeClass]">
				<view :class="['icon-btn', themeClass]" @tap="goSettings">
					<text :class="['icon-text', themeClass]">⚙</text>
				</view>
			</view>
		</view>

		<!-- 搜索栏 -->
		<view :class="['search-bar', themeClass]">
			<text class="search-icon">🔍</text>
			<text :class="['search-placeholder', themeClass]">搜索目的地、活动...</text>
		</view>

		<!-- 功能快捷入口 -->
		<view class="quick-actions">
			<view :class="['action-item', themeClass]" v-for="action in quickActions" :key="action.label" @tap="() => onAction(action.label)">
				<view :class="['action-icon-wrap', themeClass]">
					<text class="action-emoji">{{ action.icon }}</text>
				</view>
				<text :class="['action-label', themeClass]">{{ action.label }}</text>
			</view>
		</view>

		<!-- 推荐卡片区域 -->
		<view class="section-header">
			<text :class="['section-label', themeClass]">热门推荐</text>
			<text :class="['section-more', themeClass]">查看全部 →</text>
		</view>

		<scroll-view scroll-x="true" class="card-scroll" show-scrollbar="false">
			<view :class="['recommend-card', themeClass]" v-for="card in recommendCards" :key="card.title">
				<view :class="['card-img-placeholder', themeClass]">
					<text class="card-emoji">{{ card.emoji }}</text>
				</view>
				<view class="card-text">
					<text :class="['card-title', themeClass]">{{ card.title }}</text>
					<text :class="['card-sub', themeClass]">{{ card.desc }}</text>
				</view>
				<view :class="['card-tag', themeClass]">
					<text :class="['tag-text', themeClass]">{{ card.tag }}</text>
				</view>
			</view>
		</scroll-view>

		<!-- 列表区域 -->
		<view class="section-header">
			<text :class="['section-label', themeClass]">最近活动</text>
			<text :class="['section-more', themeClass]">查看更多 →</text>
		</view>

		<view :class="['list-item', themeClass]" v-for="item in activityList" :key="item.title">
			<view :class="['list-img-placeholder', themeClass]">
				<text class="list-emoji">{{ item.emoji }}</text>
			</view>
			<view class="list-content">
				<text :class="['list-title', themeClass]">{{ item.title }}</text>
				<text :class="['list-desc', themeClass]">{{ item.desc }}</text>
				<view class="list-meta">
					<text :class="['meta-text', themeClass]">{{ item.date }}</text>
					<text :class="['meta-text', themeClass]">{{ item.location }}</text>
				</view>
			</view>
			<view :class="['list-arrow', themeClass]">
				<text :class="['arrow-icon', themeClass]">›</text>
			</view>
		</view>

		<!-- 底部安全区 -->
		<view class="bottom-safe"></view>
	</view>
</template>

<script setup lang="uts">
	import { useTheme } from '@/composables/useTheme'
	import { ref, computed } from 'vue'

	const { currentTheme, isLiquidGlass, isNormal } = useTheme()

	const themeClass = computed(() => {
		return currentTheme.value === 'liquid-glass' ? 'theme-glass' : 'theme-normal'
	})

	const greetingText = computed(() => {
		const hour = new Date().getHours()
		if (hour < 12) return '早上好 ☀️'
		if (hour < 18) return '下午好 🌤'
		return '晚上好 🌙'
	})

	interface QuickAction {
		icon: string
		label: string
	}

	const quickActions = ref<QuickAction[]>([
		{ icon: '🏖️', label: '景点' },
		{ icon: '🍜', label: '美食' },
		{ icon: '🏨', label: '住宿' },
		{ icon: '🗺️', label: '路线' },
	])

	interface RecommendCard {
		emoji: string
		title: string
		desc: string
		tag: string
	}

	const recommendCards = ref<RecommendCard[]>([
		{ emoji: '🏔️', title: '雪山秘境', desc: '探索绝美雪山风光', tag: '热门' },
		{ emoji: '🏖️', title: '海岸线之旅', desc: '阳光沙滩度假天堂', tag: '推荐' },
		{ emoji: '🏯', title: '古镇漫步', desc: '体验千年文化韵味', tag: '新上线' },
		{ emoji: '🌲', title: '森林徒步', desc: '拥抱大自然氧吧', tag: '精选' },
	])

	interface ActivityItem {
		emoji: string
		title: string
		desc: string
		date: string
		location: string
	}

	const activityList = ref<ActivityItem[]>([
		{ emoji: '🎵', title: '夏日音乐节', desc: '海滩落日音乐盛宴', date: '7月15日', location: '三亚' },
		{ emoji: '🎨', title: '城市艺术展', desc: '当代艺术沉浸体验', date: '7月20日', location: '上海' },
		{ emoji: '🏃', title: '环湖马拉松', desc: '湖畔奔跑挑战自我', date: '8月1日', location: '杭州' },
		{ emoji: '🍷', title: '葡萄酒品鉴', desc: '庄园美酒品味之旅', date: '8月5日', location: '宁夏' },
	])

	function goSettings() {
		uni.navigateTo({
			url: '/pages/settings/settings'
		})
	}

	function onAction(label: string) {
		uni.showToast({
			title: `进入${label}`,
			icon: 'none'
		})
	}
</script>

