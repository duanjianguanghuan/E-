<template>
	<view :class="['home-page', themeClass]">
		<!-- 顶部导航栏 -->
		<view :class="['navbar-wrap', themeClass]">
			<view :class="['status-bar', themeClass]"></view>
			<view :class="['navbar', themeClass]">
				<view class="navbar-left">
					<text :class="['greeting', themeClass]">{{ greeting }}</text>
					<text :class="['subtitle', themeClass]">Epic 每周免费游戏</text>
				</view>
				<view class="navbar-right">
					<view :class="['icon-btn', themeClass, { loading: isRefreshing }]" @tap="onRefreshTap">
						<text :class="['icon-text', themeClass]">{{ isRefreshing ? '⟳' : '↻' }}</text>
					</view>
					<view :class="['icon-btn', themeClass]" @tap="goSettings">
						<text :class="['icon-text', themeClass]">⚙</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 页面内容区 -->
		<scroll-view
			scroll-y="true"
			class="content-scroll"
			:refresher-enabled="true"
			:refresher-triggered="isRefreshing"
			@refresherrefresh="onPullRefresh"
			@scrolltolower="onScrollBottom"
		>
			<!-- 骨架屏加载态 -->
			<view v-if="isSkeleton" class="skeleton-wrap">
				<view class="skeleton-section">
					<view class="skeleton-header"></view>
					<scroll-view scroll-x="true" class="skeleton-scroll">
						<view class="skeleton-card-list">
							<view class="skeleton-card" v-for="i in 3" :key="i">
								<view class="skeleton-img"></view>
								<view class="skeleton-text"></view>
								<view class="skeleton-text short"></view>
							</view>
						</view>
					</scroll-view>
				</view>
				<view class="skeleton-section">
					<view class="skeleton-header"></view>
					<view class="skeleton-list">
						<view class="skeleton-list-item" v-for="i in 4" :key="i">
							<view class="skeleton-thumb"></view>
							<view class="skeleton-content">
								<view class="skeleton-text"></view>
								<view class="skeleton-text short"></view>
							</view>
						</view>
					</view>
				</view>
			</view>

			<!-- 错误态 -->
			<view v-else-if="hasError" :class="['state-wrap', themeClass]">
				<text class="state-emoji">😵</text>
				<text :class="['state-text', themeClass]">{{ errorMsg }}</text>
				<view :class="['state-btn', themeClass]" @tap="loadGames">
					<text :class="['state-btn-text', themeClass]">重新加载</text>
				</view>
			</view>

			<!-- 空数据态 -->
			<view v-else-if="isEmpty" :class="['state-wrap', themeClass]">
				<text class="state-emoji">📭</text>
				<text :class="['state-text', themeClass]">本周暂无免费游戏</text>
				<text :class="['state-sub', themeClass]">下周再来看看吧</text>
			</view>

			<!-- 数据内容 -->
			<view v-else class="data-wrap">
				<!-- 本周免费 -->
				<view v-if="freeNowGames.length > 0">
					<view class="section-header">
						<view class="section-title-row">
							<text :class="['section-label', themeClass]">本周免费</text>
							<text :class="['section-badge', themeClass]">限时</text>
						</view>
					</view>

					<scroll-view scroll-x="true" class="card-scroll" enhanced="true" bounces="false">
						<view class="card-list">
							<view
								:class="['game-card', themeClass]"
								v-for="game in freeNowGames"
								:key="game.id"
								@tap="openGameLink(game)"
							>
								<view class="game-cover-wrap">
									<image
										:class="['game-cover', themeClass]"
										:src="game.cover"
										mode="aspectFill"
										lazy-load="true"
										@error="onImageError($event, game.id)"
									/>
									<view :class="['free-tag', themeClass, { urgent: getTimeDisplay(game).isUrgent }]">
										{{ getTimeDisplay(game).text.split(' ')[0] }}
									</view>
								</view>
								<view class="game-body">
									<text :class="['game-title', themeClass]">{{ game.title }}</text>
									<text :class="['game-desc', themeClass]">{{ game.seller }}</text>
									<view :class="['game-footer', themeClass]">
										<text :class="['game-time', themeClass, { urgent: getTimeDisplay(game).isUrgent }]">
											{{ getTimeDisplay(game).text }}
										</text>
									</view>
								</view>
							</view>
						</view>
					</scroll-view>
				</view>

				<!-- 即将推出 -->
				<view v-if="upcomingGames.length > 0">
					<view class="section-header">
						<view class="section-title-row">
							<text :class="['section-label', themeClass]">下周预告</text>
							<text :class="['section-badge-outline', themeClass]">敬请期待</text>
						</view>
					</view>

					<view class="upcoming-list">
						<view
							:class="['upcoming-item', themeClass]"
							v-for="game in upcomingGames"
							:key="game.id"
							@tap="openGameLink(game)"
						>
							<image
								:class="['upcoming-thumb', themeClass]"
								:src="game.cover"
								mode="aspectFill"
								lazy-load="true"
								@error="onImageError($event, game.id)"
							/>
							<view class="upcoming-content">
								<text :class="['upcoming-title', themeClass]">{{ game.title }}</text>
								<text :class="['upcoming-seller', themeClass]">{{ game.seller }}</text>
								<view :class="['upcoming-footer', themeClass]">
									<text :class="['upcoming-date', themeClass]">
										{{ formatDateTime(game.free_start) }} 起
									</text>
								</view>
							</view>
							<view :class="['upcoming-badge', themeClass]">
								<text :class="['badge-time', themeClass]">{{ getTimeDisplay(game).text }}</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 底部提示 -->
				<view :class="['footer-tip', themeClass]">
					<text :class="['tip-text', themeClass]">
						数据来源: 60s.viki.moe · 点击卡片前往 Epic 商店领取
					</text>
					<text v-if="lastUpdateTime" :class="['update-time', themeClass]">
						最后更新: {{ lastUpdateTime }}
					</text>
				</view>
			</view>

			<!-- 底部安全区 -->
			<view class="bottom-safe"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useTheme } from '@/composables/useTheme'
	import { fetchEpicGames, getFreeNowGames, getUpcomingGames, getTimeDisplay, formatDateTime, getFriendlyTime } from '@/api/epic'
	import type { EpicGame } from '@/api/epic'
	import { ref, computed, onMounted, onUnmounted } from 'vue'

	const { currentTheme, themeClass } = useTheme()

	/* ========== 状态 ========== */
	const isSkeleton = ref(true)
	const isRefreshing = ref(false)
	const errorMsg = ref<string | null>(null)
	const freeNowGames = ref<EpicGame[]>([])
	const upcomingGames = ref<EpicGame[]>([])
	const lastUpdateTime = ref<string | null>(null)
	const currentTime = ref(Date.now())

	const hasError = computed(() => errorMsg.value !== null)
	const isEmpty = computed(() => !isSkeleton.value && !hasError.value && freeNowGames.value.length === 0 && upcomingGames.value.length === 0)
	const greeting = computed(() => getFriendlyTime() + '，玩家')

	/* ========== 时间更新定时器 ========== */
	let timer: number | null = null

	function startTimer() {
		if (timer !== null) return
		timer = setInterval(() => {
			currentTime.value = Date.now()
		}, 1000) as unknown as number
	}

	function stopTimer() {
		if (timer !== null) {
			clearInterval(timer as unknown as number)
			timer = null
		}
	}

	/* ========== 时间显示工具 ========== */
	function getTimeDisplayForGame(game: EpicGame) {
		return getTimeDisplay(game.free_end, game.free_end_at, game.is_free_now)
	}

	/* ========== 数据加载 ========== */
	async function loadGames(forceRefresh: boolean = false) {
		errorMsg.value = null

		const result = await fetchEpicGames(forceRefresh)
		if (result.success && result.data) {
			freeNowGames.value = getFreeNowGames(result.data.data)
			upcomingGames.value = getUpcomingGames(result.data.data)

			// 更新最后刷新时间
			const now = new Date()
			const hours = now.getHours().toString().padStart(2, '0')
			const minutes = now.getMinutes().toString().padStart(2, '0')
			lastUpdateTime.value = `${hours}:${minutes}`

			// 启动定时器以更新倒计时
			startTimer()
		} else {
			errorMsg.value = result.message
		}
		isSkeleton.value = false
		isRefreshing.value = false
	}

	/* ========== 下拉刷新 ========== */
	function onPullRefresh() {
		if (isRefreshing.value) return
		isRefreshing.value = true
		loadGames(true)
	}

	/* ========== 刷新按钮点击（防抖） ========== */
	let refreshTimer: number | null = null
	function onRefreshTap() {
		if (isRefreshing.value) return
		if (refreshTimer !== null) {
			clearTimeout(refreshTimer)
			refreshTimer = null
			return
		}
		isRefreshing.value = true
		loadGames(true)
		refreshTimer = setTimeout(() => {
			refreshTimer = null
		}, 1000)
	}

	/* ========== 滚动到底部 ========== */
	function onScrollBottom() {
		// 预留扩展：加载更多
	}

	/* ========== 图片加载失败 ========== */
	function onImageError(e: any, gameId: string) {
		console.log('Image load error:', gameId, e)
	}

	/* ========== 打开游戏链接 ========== */
	function openGameLink(game: EpicGame) {
		if (!game.link || game.link.includes('[]') || game.link === '') {
			uni.showToast({
				title: '游戏链接暂未公布',
				icon: 'none',
				duration: 2000,
			})
			return
		}
		uni.showToast({
			title: '正在打开 Epic 商店',
			icon: 'loading',
			duration: 1500,
		})
		setTimeout(() => {
			// #ifdef H5
			window.open(game.link, '_blank')
			// #endif
			// #ifndef H5
			uni.setClipboardData({
				data: game.link,
				showToast: true,
				toastTitle: '链接已复制，请在浏览器中打开',
			})
			// #endif
		}, 800)
	}

	/* ========== 跳转设置 ========== */
	function goSettings() {
		uni.navigateTo({
			url: '/pages/settings/settings',
		})
	}

	/* ========== 生命周期 ========== */
	onMounted(() => {
		loadGames()
	})

	onUnmounted(() => {
		stopTimer()
		if (refreshTimer !== null) {
			clearTimeout(refreshTimer)
			refreshTimer = null
		}
	})
</script>

