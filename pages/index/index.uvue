<template>
	<view :class="['home-page', themeClass]">
		<!-- 顶部导航栏 -->
		<view :class="['navbar-wrap', themeClass]">
			<view :class="['status-bar', themeClass]"></view>
			<view :class="['navbar', themeClass]">
				<view class="navbar-left">
					<text :class="['greeting', themeClass]">E游周享</text>
					<text :class="['subtitle', themeClass]">Epic 每周免费游戏资讯</text>
				</view>
				<view class="navbar-right">
					<view :class="['icon-btn', themeClass]" @tap="refreshData">
						<text :class="['icon-text', themeClass]">↻</text>
					</view>
					<view :class="['icon-btn', themeClass]" @tap="goSettings">
						<text :class="['icon-text', themeClass]">⚙</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 加载状态 -->
		<view v-if="loading" :class="['loading-wrap', themeClass]">
			<text :class="['loading-text', themeClass]">正在加载...</text>
		</view>

		<!-- 错误状态 -->
		<view v-else-if="hasError" :class="['error-wrap', themeClass]">
			<text class="error-emoji">😵</text>
			<text :class="['error-text', themeClass]">{{ errorMsg }}</text>
			<view :class="['retry-btn', themeClass]" @tap="refreshData">
				<text :class="['retry-text', themeClass]">点击重试</text>
			</view>
		</view>

		<!-- 数据内容 -->
		<view v-else class="content-wrap">
			<!-- 本周免费游戏 -->
			<view v-if="freeNowGames.length > 0">
				<view class="section-header">
					<text :class="['section-label', themeClass]">本周免费</text>
					<text :class="['section-badge', themeClass]">限时领取</text>
				</view>

				<scroll-view scroll-x="true" class="card-scroll" show-scrollbar="false">
					<view class="card-scroll-inner">
						<view
							:class="['game-card', themeClass]"
							v-for="game in freeNowGames"
							:key="game.id"
							@tap="() => openGameLink(game.link)"
						>
							<image
								:class="['game-cover', themeClass]"
								:src="game.cover"
								mode="aspectFill"
							/>
							<view class="game-info">
								<text :class="['game-title', themeClass]">{{ game.title }}</text>
								<text :class="['game-desc', themeClass]">{{ game.description }}</text>
								<view :class="['game-meta', themeClass]">
									<text :class="['game-tag-free', themeClass]">免费</text>
									<text :class="['game-time', themeClass]">
										截止 {{ formatFreeTime(game.free_end) }}
									</text>
								</view>
							</view>
						</view>
					</view>
				</scroll-view>
			</view>

			<!-- 即将推出 -->
			<view v-if="upcomingGames.length > 0">
				<view class="section-header">
					<text :class="['section-label', themeClass]">即将推出</text>
					<text :class="['section-badge-outline', themeClass]">敬请期待</text>
				</view>

				<view :class="['list-item', themeClass]" v-for="game in upcomingGames" :key="game.id">
					<image
						:class="['list-cover', themeClass]"
						:src="game.cover"
						mode="aspectFill"
					/>
					<view class="list-content">
						<text :class="['list-title', themeClass]">{{ game.title }}</text>
						<text :class="['list-desc', themeClass]">{{ game.description }}</text>
						<view class="list-meta">
							<text :class="['meta-text', themeClass]">
								{{ formatFreeTime(game.free_start) }} 起
							</text>
						</view>
					</view>
					<view :class="['list-badge', themeClass]">
						<text :class="['badge-text', themeClass]">预告</text>
					</view>
				</view>
			</view>

			<!-- 空数据 -->
			<view v-if="freeNowGames.length === 0 && upcomingGames.length === 0" :class="['empty-wrap', themeClass]">
				<text class="empty-emoji">📭</text>
				<text :class="['empty-text', themeClass]">暂无游戏数据</text>
			</view>

			<!-- 底部提示 -->
			<view :class="['footer-tip', themeClass]">
				<text :class="['tip-text', themeClass]">
					数据来源: 60s.viki.moe · 点击卡片前往 Epic 商店领取
				</text>
			</view>
		</view>

		<!-- 底部安全区 -->
		<view class="bottom-safe"></view>
	</view>
</template>

<script setup lang="uts">
	import { useTheme } from '@/composables/useTheme'
	import { fetchEpicGames, getFreeNowGames, getUpcomingGames, formatFreeTime } from '@/api/epic'
	import type { EpicGame } from '@/api/epic'
	import { ref, computed } from 'vue'

	const { currentTheme } = useTheme()

	const themeClass = computed(() => {
		return currentTheme.value === 'liquid-glass' ? 'theme-glass' : 'theme-normal'
	})

	/* ========== 数据状态 ========== */
	const loading = ref(true)
	const errorMsg = ref<string | null>(null)
	const freeNowGames = ref<EpicGame[]>([])
	const upcomingGames = ref<EpicGame[]>([])

	const hasError = computed(() => errorMsg.value !== null)

	/* ========== 数据加载 ========== */
	async function loadGames() {
		loading.value = true
		errorMsg.value = null

		const result = await fetchEpicGames()
		if (result.success && result.data != null) {
			freeNowGames.value = getFreeNowGames(result.data.data)
			upcomingGames.value = getUpcomingGames(result.data.data)
		} else {
			errorMsg.value = result.message
		}
		loading.value = false
	}

	function refreshData() {
		loadGames()
	}

	/* ========== 交互 ========== */
	function openGameLink(link: string) {
		if (!link || link.includes('[]')) {
			uni.showToast({
				title: '暂未公布，敬请期待',
				icon: 'none',
			})
			return
		}
		uni.showToast({
			title: '即将跳转至 Epic 商店',
			icon: 'none',
		})
	}

	function goSettings() {
		uni.navigateTo({
			url: '/pages/settings/settings',
		})
	}

	/* ========== 初始化 ========== */
	loadGames()
</script>

